# Tixx – wzorcowy plik zmiennych środowiskowych
# Skopiuj do .env i uzupełnij wartości

POSTGRES_DB=tixx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
ADMINER_PORT=8080
WEB_PORT=3000
TZ=Europe/Warsaw

# AI triage zgłoszeń (Gemini API) – klucz z https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_TRIAGE_MODEL=gemini-3.5-flash-lite

